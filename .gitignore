# --- generated data: lives on the gh-pages branch, never on main ---
# Every path below is pipeline output. Regenerate it by re-running the script
# in Python/ (or the tool's own pipeline/), then `deploy.sh` to publish.
# main carries the code and the decision history; gh-pages carries the bytes.
/fsa_json/
/newhomes_fsa/
/newhomes_json/
/province_json/
/insights_json/
/ceud_json/
/construction_json/
/grid_json/
/prices_json/
/geo_json/
/census_json/
/lookup/
/FSA_Maps/
/GridCapacity/
# HeatPump/data is local-only EXCEPT cell_candidates.csv, which carries
# HAND-ENTERED datasheet findings (Spec sheet / page / note) that no pipeline
# can regenerate. Directory contents are excluded rather than the directories
# themselves, because git cannot re-include a file inside an excluded directory.
/HeatPump/data/**
!/HeatPump/data/
!/HeatPump/data/interim/
!/HeatPump/data/interim/cell_candidates.csv
/Geothermal/output/
# Generated by HeatPump/pipeline/build_tier_scatter.py; published to gh-pages
# only, as a temporary discussion aid. Regenerate, don't commit.
/tier-scatter.html
/utility_rates_reference.json
/utility_rates_reference.csv
.nojekyll

# --- scratch / build junk ---
__pycache__/
_palcheck.tmp.js
Python/*.log

# --- scrape & download caches (regenerable) ---
Python/construction_cache/
Python/rates_cache/
/climate_cache/

# --- large raw inputs, kept locally only (not served, not needed by CI) ---
/Census
lfsa000b21a_e.json
/heatpump/data/raw/**
# Contents, not the directory — and the same cell_candidates.csv exception as
# above, repeated because this lowercase spelling also matches on a
# case-insensitive filesystem.
/heatpump/data/interim/**
!/heatpump/data/interim/cell_candidates.csv
HeatPump/All_Generators_Aggregated.xlsx

# --- Geothermal: build inputs & intermediates ---
# Geothermal/output/index.html is fully self-contained; nothing below is served.
# Raw well extracts (Geothermal/Data/tbl*_Ottawa.csv) stay tracked — the source
# .mdb is untracked, so those CSVs are the only committed raw record.
/Geothermal/Data/Raw
Geothermal/Data/processed/
Geothermal/Data/wwis_out.*
Geothermal/Data/M183-2-6914-eng.pdf
